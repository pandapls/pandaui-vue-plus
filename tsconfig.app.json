{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"include": [
		"packages/components/**/*.ts",
		"packages/components/**/*.vue",
		"packages/utils/**/*.ts"
	],
	"exclude": ["src/**/__tests__/*"],
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"composite": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@pandaui-vue-plus/*": ["./packages/*"]
		},
		"types": ["node"]
	}
}
