{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
		"examples/vite.config.*",
		"examples/vitest.config.*",
		"examples/cypress.config.*",
		"examples/nightwatch.conf.*",
		"examples/playwright.config.*",
		"examples/eslint.config.*"
	],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
